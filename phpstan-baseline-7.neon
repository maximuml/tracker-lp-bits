parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$value of method Carbon\\Carbon\:\:subDays\(\) expects float\|int, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Console/Commands/DeleteExpiredToken.php

		-
			message: '#^Parameter \#1 \$callback of function call_user_func_array expects callable\(\)\: mixed, array\{class\-string, ''dispatch''\} given\.$#'
			identifier: argument.type
			count: 1
			path: app/Console/Commands/FireEvent.php

		-
			message: '#^Parameter \#1 \$callback of function call_user_func expects callable\(\)\: mixed, array\{Nexus\\Plugin\\BasePlugin, ''uninstall''\} given\.$#'
			identifier: argument.type
			count: 1
			path: app/Console/Commands/Plugin.php

		-
			message: '#^Offset ''type'' might not exist on array\{type\?\: mixed, torrent\?\: mixed, text\?\: mixed, ori_text\?\: mixed, offer\?\: mixed, request\?\: mixed, anonymous\?\: mixed\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: app/Http/Controllers/CommentController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 3
			path: app/Http/Controllers/LegacyController.php

		-
			message: '#^Parameter \#5 \$editItem of method App\\Http\\Controllers\\LogController\:\:chronicleList\(\) expects array\<string, mixed\>\|null, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/LogController.php

		-
			message: '#^Property App\\Models\\Topic\:\:\$hlcolor \(int\<0, max\>\) does not accept int\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Http/Controllers/TopicController.php

		-
			message: '#^Cannot cast float\|int\|list\<string\>\|string to string\.$#'
			identifier: cast.string
			count: 1
			path: app/Http/Controllers/TorrentEditController.php

		-
			message: '#^Parameter \#1 \$user of static method App\\Support\\Bonus\:\:buildBonusTableForUser\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/UserDetailController.php

		-
			message: '#^Call to an undefined method App\\Models\\UserMedal\|Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\UserMedal\>\:\:delete\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Controllers/UserMedalController.php

		-
			message: '#^Parameter \#1 \$attributes of method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\Message\>\:\:create\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Models/Message.php

		-
			message: '#^Parameter \#1 \$key of method App\\Support\\Config\\MainConfig\:\:category\(\) expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Models/SearchBox.php

		-
			message: '#^Method App\\Models\\Setting\:\:getBonusRewardOptions\(\) should return array\<int\|string, mixed\> but returns list\<string\>\|false\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Setting.php

		-
			message: '#^Parameter \#1 \$attributes of method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\TorrentOperationLog\>\:\:create\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Models/TorrentOperationLog.php

		-
			message: '#^Call to an undefined method App\\Models\\Torrent\|Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\Torrent\>\:\:checkIsNormal\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Repositories/BookmarkRepository.php

		-
			message: '#^Binary operation "\+" between int\|non\-falsy\-string and int\<2, max\> results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: app/Repositories/CleanupRepository.php

		-
			message: '#^Parameter \#3 \$lastTime of static method App\\Repositories\\CleanupRepository\:\:getAlarmEmailBodyForCleanup\(\) expects int, int\|string given\.$#'
			identifier: argument.type
			count: 2
			path: app/Repositories/CleanupRepository.php

		-
			message: '#^Cannot call method toArray\(\) on App\\Models\\Offer\|App\\Models\\Torrent\|stdClass\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Repositories/CommentRepository.php

		-
			message: '#^Parameter \#1 \$string of function substr expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/MeiliSearchRepository.php

		-
			message: '#^Parameter \#1 \$values of method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\User\>\:\:update\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/ModtaskRepository.php

		-
			message: '#^Parameter \#3 \$extra of method Illuminate\\Database\\Query\\Builder\:\:increment\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/ModtaskRepository.php

		-
			message: '#^Parameter \#1 \$attributes of method Illuminate\\Database\\Eloquent\\Model\:\:update\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/PluginRepository.php

		-
			message: '#^Parameter \#1 \$string of function trim expects string, array\<int\|string, mixed\>\|string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/PluginRepository.php

		-
			message: '#^Method App\\Repositories\\ShoutboxRepository\:\:getMyReactions\(\) should return list\<string\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: app/Repositories/ShoutboxRepository.php

		-
			message: '#^Method App\\Repositories\\ToptenRepository\:\:toArray\(\) should return list\<array\<string, mixed\>\> but returns array\<int, array\>\.$#'
			identifier: return.type
			count: 1
			path: app/Repositories/ToptenRepository.php

		-
			message: '#^Parameter \#1 \$values of method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\Torrent\>\:\:update\(\) expects array\<string, mixed\>, array\<int\|string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/TorrentEditRepository.php

		-
			message: '#^Parameter \#1 \$value of function count expects array\|Countable, array\<int\|string, mixed\>\|string\|null given\.$#'
			identifier: argument.type
			count: 2
			path: app/Repositories/TorrentSearchRepository.php

		-
			message: '#^Parameter \#1 \$json of function json_decode expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/UserPasskeyRepository.php

		-
			message: '#^Parameter \#2 \$timestamp of function date expects int\|null, int\|false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Repositories/UserSearchRepository.php
