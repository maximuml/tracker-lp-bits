{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "app/Http/Controllers/",
            "app/Services/",
            "app/Policies/"
        ]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "mutators": {
        "global-ignore": [],
        "@default": true
    },
    "testFramework": "phpunit",
    "bootstrap": "vendor/autoload.php",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 40,
    "minCoveredMsi": 50,
    "threads": 4,
    "timeout": 10
}
