includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline-8.neon

parameters:
    level: 8
    paths:
        - app/Auth
        - app/Console
        - app/Contracts
        - app/DTOs
        - app/Enums
        - app/Events
        - app/Exceptions
        - app/Filament
        - app/Http
        - app/Jobs
        - app/Listeners
        - app/Logging
        - app/Models
        - app/Observers
        - app/Policies
        - app/Providers
        - app/Repositories
        - app/Services
        - app/Support
        - app/Utils
        - app/ValueObjects
        - app/View
        - app/ViewModels

    excludePaths:
        analyse:
            - app/Services/Legacy/partials (?)
            - app/Services/Legacy/*_content.php
            # Standalone legacy installer (IN_NEXUS=true, own NexusDB layer).
            # Removed wholesale by the installer migration step — do not add
            # per-file fixes here, delete the directory instead.
            - app/Support/Install

    bootstrapFiles:
        - tests/phpstan/bootstrap.php
        - tests/phpstan/constants.stub.php
        - tests/phpstan/globals.stub.php
        - bootstrap/app.php

    scanFiles:
        - config/nexus_constants.php

    scanDirectories:
        - vendor

    dynamicConstantNames:
        - IN_NEXUS
        - IN_TRACKER
        - RUNNING_IN_OCTANE

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            message: '#does not specify its types: TModel#'
            path: app/Utils/ApiQueryBuilder.php

    universalObjectCratesClasses:
        - Illuminate\Http\Resources\Json\JsonResource
