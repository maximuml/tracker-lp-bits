includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/Support
        - app/Models
        - app/Console
        - app/Http
        - app/Repositories

    excludePaths:
        analyse:
            - app/Support/Legacy

    bootstrapFiles:
        - tests/phpstan/bootstrap.php
        - tests/phpstan/constants.stub.php
        - tests/phpstan/globals.stub.php
        - bootstrap/app.php

    scanFiles:
        - config/nexus_constants.php

    scanDirectories:
        - app/Support/Legacy
        - vendor
        - classes

    dynamicConstantNames:
        - IN_NEXUS
        - IN_TRACKER
        - RUNNING_IN_OCTANE

    treatPhpDocTypesAsCertain: false

    ignoreErrors:

    universalObjectCratesClasses:
        - Illuminate\Http\Resources\Json\JsonResource
