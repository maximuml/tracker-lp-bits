server {
    listen 443 ssl;
    http2 on;
    server_name ${NP_DOMAIN};

    root /var/www/html/public;
    index index.php index.html;

    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/private.key;

    client_max_body_size 100M;

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    # Filament
    location ^~ /filament {
        try_files $uri $uri/ /nexus.php$is_args$args;
    }

    # All non-static requests fall back to the single Laravel entry point.
    location / {
        try_files $uri $uri/ /nexus.php?$query_string;
    }

    # Tracker announce with Lua validation.
    location ~ ^/announce(?:\.php)?$ {
        access_by_lua_block {
            local filter = require("tracker_filter")
            filter()
        }
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/nexus.php;
        fastcgi_param SCRIPT_NAME /announce.php;
        fastcgi_param REQUEST_ID $request_id;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
    }

    # Scrape endpoint.
    location ~ ^/scrape(?:\.php)?$ {
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/nexus.php;
        fastcgi_param SCRIPT_NAME /scrape.php;
        fastcgi_param REQUEST_ID $request_id;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
    }

    # confirmemail.php/<id>/<md5>/<email> uses PATH_INFO.
    location ~ ^/confirmemail\.php(/.*)?$ {
        fastcgi_split_path_info ^(/confirmemail\.php)(/.*)$;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/nexus.php;
        fastcgi_param SCRIPT_NAME /confirmemail.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param REQUEST_ID $request_id;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
    }

    # Remaining .php URLs (including the root index.php wrapper) are served if the
    # file still exists; otherwise they fall through to nexus.php so legacy URLs
    # like /torrents.php keep working after the per-page wrappers are removed.
    location ~ \.php$ {
        try_files $uri /nexus.php =404;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param REQUEST_ID $request_id;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
    }

    # Static attachments outside the public root (matches attachment.savedirectory = ./attachments)
    location /attachments/ {
        alias /var/www/html/attachments/;
    }
}
