# Production Dockerfile for tracker-lp-bits
# Multi-stage build: ext-builder (compiled exts) → vendor (composer) → production (runtime only)
#
# Usage:
#   docker build -f .docker/php/Dockerfile.prod -t tracker-lp-bits:prod .
#   NEXUSPHP_ENV=prod by default; set --build-arg NEXUSPHP_ENV=dev for dev opcache settings

# ── Stage 1: Build PHP extensions ──────────────────────────────────────────
# T-13: Digest-pinned for reproducible builds. Update via Renovate.
FROM php:8.5-fpm-alpine@sha256:059977c6511192520341f9ae5f106714b7834803d916f6eb592a9e19514a11de AS ext-builder

RUN apk add --no-cache \
    $PHPIZE_DEPS \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    libxml2-dev \
    libwebp-dev \
    gmp-dev \
    oniguruma-dev \
    linux-headers

RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp

RUN docker-php-ext-install -j$(nproc) \
    bcmath \
    pdo_mysql \
    mysqli \
    gd \
    pcntl \
    sockets \
    gmp \
    zip \
    intl

RUN pecl channel-update pecl.php.net \
    && pecl install redis-6.3.0 \
    && docker-php-ext-enable redis

# ── Stage 2: Composer dependencies (production, no dev) ────────────────────
# T-13: Digest-pinned for reproducible builds. Update via Renovate.
FROM composer:2@sha256:0baf37e7f495f1c42cee6bdd9cf3e00e9435f193b512529e7c484d66c623773f AS vendor-builder

COPY composer.json composer.lock /app/
COPY artisan /app/artisan
COPY database/ /app/database/
COPY app/ /app/app/
COPY config/ /app/config/
COPY routes/ /app/routes/
COPY bootstrap/ /app/bootstrap/

# Install only production dependencies (no dev, no scripts — scripts run in entrypoint)
# --ignore-platform-req: extensions are installed in the runtime stage, not here
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --ignore-platform-req=ext-bcmath \
    --ignore-platform-req=ext-gd \
    --ignore-platform-req=ext-gmp \
    --ignore-platform-req=ext-intl \
    --ignore-platform-req=ext-mysqli \
    --ignore-platform-req=ext-pcntl \
    --ignore-platform-req=ext-redis \
    --ignore-platform-req=ext-pdo_mysql \
    --ignore-platform-req=ext-sockets \
    --ignore-platform-req=ext-zip

# Generate optimized autoloader (no scripts — Octane is dev-only)
RUN composer dump-autoload \
    --no-dev \
    --optimize \
    --classmap-authoritative \
    --no-scripts

# ── Stage 3: Production runtime ────────────────────────────────────────────
FROM php:8.5-fpm-alpine@sha256:059977c6511192520341f9ae5f106714b7834803d916f6eb592a9e19514a11de AS production

# Copy compiled extensions from ext-builder
COPY --from=ext-builder /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=ext-builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Install only runtime libraries (no build tools, no git, no mysql-client)
RUN apk add --no-cache \
    wget~=1.25 \
    libzip \
    libpng \
    libjpeg-turbo \
    libwebp \
    freetype \
    icu \
    libxml2 \
    gmp \
    oniguruma

# Configure PHP-FPM: log to stderr, tune for production
RUN sed -i \
    -e 's/;catch_workers_output = .*/catch_workers_output = yes/g' \
    -e 's/;php_admin_flag\[log_errors\] = .*/php_admin_flag\[log_errors\] = on/g' \
    -e 's/;php_admin_value\[error_log\] = .*/php_admin_value\[error_log\] = \/dev\/stderr/g' \
    -e 's/^pm = .*/pm = dynamic/g' \
    -e 's/^pm.max_children = .*/pm.max_children = 50/g' \
    -e 's/^pm.start_servers = .*/pm.start_servers = 5/g' \
    -e 's/^pm.min_spare_servers = .*/pm.min_spare_servers = 5/g' \
    -e 's/^pm.max_spare_servers = .*/pm.max_spare_servers = 35/g' \
    -e 's/^pm.max_requests = .*/pm.max_requests = 1000/g' \
    /usr/local/etc/php-fpm.d/www.conf

RUN echo "error_log = /dev/stderr" >> /usr/local/etc/php/conf.d/error-logging.ini
RUN echo "upload_max_filesize = 10M" >> /usr/local/etc/php/conf.d/upload.ini
RUN echo "post_max_size = 10M" >> /usr/local/etc/php/conf.d/upload.ini

# Production OPcache (override with --build-arg NEXUSPHP_ENV=dev for development)
ARG NEXUSPHP_ENV=prod
COPY .docker/php/opcache.${NEXUSPHP_ENV}.ini /usr/local/etc/php/conf.d/opcache.ini

# Install Composer (only needed for build-time; not in runtime)
# Runtime has no composer, no git, no mysql-client

ENV LOG_CHANNEL=stderr
ENV RUNNING_IN_DOCKER=1

# Copy application code (excluding dev-only files via .dockerignore)
COPY --chown=www-data:www-data . /var/www/html

# Copy pre-built vendor from vendor-builder
COPY --from=vendor-builder --chown=www-data:www-data /app/vendor /var/www/html/vendor
COPY --from=vendor-builder --chown=www-data:www-data /app/composer.lock /var/www/html/composer.lock

# Ensure writable directories exist (mounted as volumes in prod compose)
RUN mkdir -p /var/www/html/attachments /var/www/html/torrents \
    /var/www/html/storage/framework/views /var/www/html/storage/framework/sessions \
    /var/www/html/storage/framework/cache/data \
    /var/www/html/storage/logs /var/www/html/storage/app/public \
    /var/www/html/bootstrap/cache \
    && chown -R www-data:www-data /var/www/html/attachments /var/www/html/torrents \
    /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache \
    /var/www/html/attachments /var/www/html/torrents

# Build Laravel caches at image build time (config/route/view/icons/filament)
# T-14: Fail-fast — no `|| true` or `2>/dev/null`. If any cache command
# fails, the image build fails. This catches missing extensions, broken
# config, and invalid routes before the image reaches production.
# W8-05: .env is dockerignored so published images carry no secrets. The
# artisan boots below need *a* valid APP_KEY (AppServiceProvider throws on
# a placeholder) — a per-build throwaway, overwritten when the entrypoint
# re-warms caches against the mounted runtime .env. config.php is then
# removed: a baked config makes Laravel skip .env entirely at runtime
# (configurationIsCached short-circuits LoadEnvironmentVariables), and
# named volumes inherit image contents on first mount — a stale build
# cache would mask the real runtime secrets permanently.
RUN export APP_KEY="base64:$(head -c 32 /dev/urandom | base64 | tr -d '\n')" \
    && cd /var/www/html \
    && php artisan storage:link --force \
    && php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache \
    && php artisan icons:cache \
    && php artisan filament:cache-components \
    && rm -f bootstrap/cache/config.php \
    && chown -R www-data:www-data /var/www/html/bootstrap/cache

# Production entrypoint — no composer install, no install-script copy
COPY .docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Run as non-root user
USER www-data

WORKDIR /var/www/html

ENTRYPOINT ["entrypoint.sh"]
