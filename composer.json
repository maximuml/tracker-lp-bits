{
    "name": "xiaomlove/nexusphp",
    "description": "A private tracker application base on NexusPHP.",
    "type": "project",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "xiaomlove",
            "email": "1939737565@qq.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "config/nexus_constants.php"
        ]
    },
    "require": {
        "php": ">=8.4 <8.6",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-gmp": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "ext-sqlite3": "*",
        "ext-xml": "*",
        "ext-zend-opcache": "*",
        "ext-zip": "*",
        "filament/filament": "~5.0",
        "flowframe/laravel-trend": "^0.5",
        "geoip2/geoip2": "^3.0",
        "google/auth": "^1.45",
        "hashids/hashids": "^5.0",
        "irazasyed/telegram-bot-sdk": "^3.11",
        "laravel/framework": "^13.27",
        "laravel/horizon": "^5.31",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.5",
        "lbuchs/webauthn": "^2.2",
        "league/flysystem-sftp-v3": "^3.0",
        "meilisearch/meilisearch-php": "^1.0",
        "rhilip/bencode": "^2.5.0",
        "rlanvin/php-ip": "^3.0",
        "robthree/twofactorauth": "^3.0",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.0",
        "stichoza/google-translate-php": "^5.2"
    },
    "require-dev": {
        "calebporzio/sushi": "^2.5",
        "fakerphp/faker": "^1.23",
        "kitloong/laravel-migrations-generator": "^7.0",
        "larastan/larastan": "^3.0",
        "laravel-lang/lang": "^15.10",
        "laravel-lang/publisher": "^16.0",
        "laravel/octane": "^2.19",
        "laravel/pint": "^1.30",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "orangehill/iseed": "^3.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "spiral/roadrunner-cli": "^2.7",
        "spiral/roadrunner-http": "^4.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan filament:upgrade",
            "@php artisan livewire:publish --assets"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        },
        "process-timeout": 900
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
