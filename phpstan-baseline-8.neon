parameters:
	# Step 0.5: type debt exposed by adding app/Contracts to paths.
	# All entries are missingType.* on legacy repository interfaces —
	# fix by adding signatures to the interface AND its implementation
	# together, then regenerate: phpstan analyse --generate-baseline.
	ignoreErrors:
		-
			message: '#^Method App\\Contracts\\Repositories\\AuthRepositoryInterface\:\:banLoginAttempts\(\) has no return type specified\.$#'
