# Dev-only files — not needed in production image
# Note: .docker/php/entrypoint.sh and opcache.dev.ini are still needed by the
# dev Dockerfile, so they are NOT excluded here. The prod Dockerfile uses
# entrypoint.prod.sh and opcache.prod.ini instead.
/tests
/.github
/.agents
/.devin
/.raw-queries-baseline.txt
/AGENTS.md
/modernization-*.md
/audit-*.md
/.gitleaksignore

# Octane is a dev-only dependency (require-dev). The octane.yml workflow
# runs Octane tests directly on the runner with composer install (not in
# Docker). Excluding config/octane.php prevents config:cache from failing
# in the production image where Laravel\Octane\Octane is not available.
/config/octane.php
